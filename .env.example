# Claude API key (required) — used by the agent "brain" for all teams.
# Get one at https://console.anthropic.com/settings/keys
# NOTE: Vite only exposes env vars prefixed with VITE_ to client code,
# so this must be VITE_ANTHROPIC_API_KEY, not ANTHROPIC_API_KEY.
VITE_ANTHROPIC_API_KEY=

# Gemini API key (optional) — used only by teams that generate images,
# music, or video (Nano Banana Lab / Lyria Factory / Veo Studio).
# Get one at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
